// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String?      @unique
  emailVerified DateTime?    @map("email_verified")
  image         String?
  contact       String?      @unique
  provinsi      String?
  kota          String?
  kecamatan     String?
  kelurahan     String?
  address       String?
  OTP           String?
  role          String?
  pencarian     Json?
  Status        String?
  accounts      Account[]
  sessions      Session[]
  pesanan       Pesanan[]
  notifikasi    Notifikasi[]
  agenda        Agenda[]
  userName      String?      @unique
  password      String?
  CreateDateAt  DateTime?     @default(now())
  UpdatedAt     DateTime?     @updatedAt
  Paket         Paket[]
  Rute          Rute[]
  travel        travel[]
  Carousel      Carousel[]
  Testimony     Testimony[]
}

model Pesanan {
  id           String      @id @default(cuid())
  nomorPesanan String
  status       String
  jenispesanan String
  harga        String
  pesan        User?       @relation(fields: [PesanId], references: [email])
  PesanId      String?
  notiv        Notifikasi? @relation(fields: [notivId], references: [id])
  notivId      String?
  paket        Paket?      @relation(fields: [paketId], references: [id])
  paketId      String?
  CreateDateAt DateTime    @default(now())
  UpdatedAt    DateTime    @updatedAt
  travel       travel?     @relation(fields: [travelId], references: [id])
  travelId     String?
}

model Carousel {
  id           String   @id @default(cuid())
  carousel     Json?
  promo        Json?
  author       User?    @relation(fields: [AuthorId], references: [email])
  AuthorId     String?
  CreateDateAt DateTime @default(now())
  UpdatedAt    DateTime @updatedAt
}

model Testimony {
  id           String   @id @default(cuid())
  name         String?
  pengalaman   String?
  star         String
  author       User?    @relation(fields: [AuthorId], references: [email])
  AuthorId     String?
  CreateDateAt DateTime @default(now())
  UpdatedAt    DateTime @updatedAt
}

model Notifikasi {
  id           String    @id @default(cuid())
  judulPesan   String
  StatusPesan  String
  keterangan   String
  statusNotiv  String
  Notiv        User?     @relation(fields: [NotivId], references: [email])
  NotivId      String?
  pesanan      Pesanan[]
  agendas      Agenda[]
  CreateDateAt DateTime  @default(now())
  UpdatedAt    DateTime  @updatedAt
  Rute         Rute?     @relation(fields: [ruteId], references: [id])
  ruteId       String?
}

model Paket {
  id            String    @id @default(cuid())
  isipaket      String
  resi          String?
  from          String?
  fotoPaket     String?
  fotoPenerima  String?
  to            String?
  cityf         String
  cityt         String
  jadwal        String
  pay           String
  jam           String
  berat         String
  volume        String
  jenisPaket    String?
  namaPengirim  String? 
  namaPenerima  String?
  nomorPengirim String
  nomorPenerima String
  harga         String
  author        User?     @relation(fields: [AuthorId], references: [contact])
  AuthorId      String?
  CreateDateAt  DateTime  @default(now())
  UpdatedAt     DateTime  @updatedAt
  Pesanan       Pesanan[]
}

model travel {
  id             String    @id @default(cuid())
  from           String?
  resi           String?
  to             String?
  mapfrom        String
  cityf          String
  cityt          String
  mapto          String
  jadwal         String
  jam            String
  pay            String
  image          String?
  status         String?
  namaPenumpang  String
  jenisTravel    String
  nomorPengirim  String
  harga          String
  author         User?     @relation(fields: [AuthorId], references: [contact])
  AuthorId       String?
  CreateDateAt   DateTime  @default(now())
  UpdatedAt      DateTime  @updatedAt
  Pesanan        Pesanan[]
}

model Rute {
  id            String  @id @default(cuid())
  From          String
  to            String
  image         String?
  provinsi      String?
  kota          String?
  Kecamatan     String?
  Kelurahan     String?
  alamat        String
  Latitude      String?
  Longitude     String?
  jadwal        String?
  jamOprasional String?
  harga         String?
  Notifikasi   Notifikasi[]
  Author       User?        @relation(fields: [AuthorId], references: [email])
  AuthorId     String?
  CreateDateAt DateTime     @default(now())
  UpdatedAt    DateTime     @updatedAt
}

model Agenda {
  id                String      @id @default(cuid())
  namaKegiatan      String
  namaInstansi      String
  fotoProfile       String?
  background        String?
  deskripsiKegiatan String
  jadwal            String
  Jam               String
  fee               String?
  kategori          String
  instagram         String?
  facebook          String?
  tiktok            String?
  Latitude          String?
  longitude         String?
  kota              String?
  provinsi          String?
  status            String
  kontak            String
  users             User?       @relation(fields: [userId], references: [email], onDelete: Cascade)
  userId            String?     @map("user_id")
  notiv             Notifikasi? @relation(fields: [notivId], references: [id])
  notivId           String?
  CreateDateAt      DateTime    @default(now())
  UpdatedAt         DateTime    @updatedAt
  komunitasId       String?
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}
